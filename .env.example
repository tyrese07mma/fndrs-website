# Public URL of the website (canonical URLs, OpenGraph, sitemap, structured data).
# Falls back to the Vercel production domain, then to https://fndrs-society-website.vercel.app
NEXT_PUBLIC_SITE_URL=https://example.com

# Where Early Access + contact submissions go. Configure at least one,
# otherwise the forms show "opening soon" on the live site.
# 1) Any endpoint that accepts a JSON POST (Make, Zapier, n8n, ...)
FORMS_WEBHOOK_URL=
# 2) Supabase: run supabase/website_submissions.sql once, then set both values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
